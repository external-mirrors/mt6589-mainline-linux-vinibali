/dts-v1/;

/ {
	compatible = "zidoo,x9s", "realtek,rtd1295";
	model = "QNAP TS-228A";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	memory@1f000 {
		device_type = "memory";
		reg = <0x1f000 0x7ffe1000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x0>;
			enable-method = "psci";
			next-level-cache = <&l2>;
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x1>;
			enable-method = "psci";
			next-level-cache = <&l2>;
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x2>;
			enable-method = "psci";
			next-level-cache = <&l2>;
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x3>;
			enable-method = "psci";
			next-level-cache = <&l2>;
		};

		l2: l2-cache {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
		};
	};

	/* Updated PSCI node to resolve the "Conflicting version" error */
	psci {
		compatible = "arm,psci";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 0xf08>, <1 14 0xf08>, <1 11 0xf08>, <1 10 0xf08>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x1f000>, <0x80000000 0x80000000 0x80000000>;

		rbus: bus@98000000 {
			compatible = "simple-bus";
			reg = <0x98000000 0x200000>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x98000000 0x200000>;

			syscon@0 {
				compatible = "syscon", "simple-mfd";
				reg = <0x0 0x1800>;
				#address-cells = <1>;
				#size-cells = <1>;
				ranges = <0x0 0x0 0x1800>;
				reset2: reset-controller@4 {
					compatible = "snps,dw-low-reset";
					reg = <0x4 0x4>;
					#reset-cells = <1>;
				};
			};

			uart0: serial@7800 {
				compatible = "snps,dw-apb-uart";
				reg = <0x7800 0x400>;
				interrupts = <0 54 4>;
				reg-shift = <2>;
				reg-io-width = <4>;
				clock-frequency = <27000000>;
				status = "okay";
			};

			/* Fixed: Added reg property to match unit-address and satisfy DTC */
			usb2_phy0: usb-phy@13200 {
				compatible = "usb-nop-xceiv";
				reg = <0x13200 0x100>;
				#phy-cells = <0>;
				status = "okay";
			};

			usb@13000 {
				compatible = "generic-ehci";
				reg = <0x13000 0x1000>;
				interrupts = <0 21 4>;
				resets = <&reset2 15>;
				phys = <&usb2_phy0>;
				phy-names = "usb2-phy";
				status = "okay";
			};
		};

		gic: interrupt-controller@ff011000 {
			compatible = "arm,gic-400";
			reg = <0xff011000 0x1000>, <0xff012000 0x2000>, <0xff014000 0x2000>, <0xff016000 0x2000>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};
	};
};
